  "item": [
    {
      "name": "01 — Get Disk Info",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response is valid JSON\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"Disk information contains required fields\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data).to.have.property(\"total_space\");\n    pm.expect(data).to.have.property(\"used_space\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "OAuth {{oauth_token}}"
          }
        ],
        "url": {
          "raw": "https://cloud-api.yandex.net/v1/disk",
          "protocol": "https",
          "host": [
            "cloud-api",
            "yandex",
            "net"
          ],
          "path": [
            "v1",
            "disk"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 — Create Folder",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Response is valid JSON\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"Response contains resource method\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data).to.have.property(\"method\");\n    pm.expect(data.method).to.eql(\"GET\");\n});"
            ]
          }
        }
