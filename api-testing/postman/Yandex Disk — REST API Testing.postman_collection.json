    {
      "name": "05 — Upload File from URL",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 202\", function () {\n    pm.response.to.have.status(202);\n});\n\npm.test(\"Response is valid JSON\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"Upload operation URL is present\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data).to.have.property(\"href\");\n    pm.expect(data.href).to.be.a(\"string\").and.not.empty;\n});\n\nconst data = pm.response.json();\npm.environment.set(\"upload_operation_url\", data.href);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "OAuth {{oauth_token}}"
          }
        ],
        "url": {
          "raw": "https://cloud-api.yandex.net/v1/disk/resources/upload?path=/qa-api-test-2/file-from-url.pdf&url=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
          "protocol": "https",
          "host": [
            "cloud-api",
            "yandex",
            "net"
          ],
          "path": [
            "v1",
            "disk",
            "resources",
            "upload"
          ],
          "query": [
            {
              "key": "path",
              "value": "/qa-api-test-2/file-from-url.pdf"
            },
            {
              "key": "url",
              "value": "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "06 — Check Upload Operation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response is valid JSON\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"Upload operation completed successfully\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.status).to.eql(\"success\");\n});"
            ]
