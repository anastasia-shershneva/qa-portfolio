    {
      "name": "03 — Upload File from PC",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response is valid JSON\", function () {\n    pm.response.to.be.json;\n});\n\npm.test(\"Upload URL is present\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data).to.have.property(\"href\");\n    pm.expect(data.href).to.be.a(\"string\").and.not.empty;\n});\n\npm.test(\"Upload URL uses HTTPS\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.href).to.match(/^https:\\/\\//);\n});\nconst data = pm.response.json();\npm.environment.set(\"upload_url\", data.href);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "OAuth {{oauth_token}}"
          }
        ],
        "url": {
          "raw": "https://cloud-api.yandex.net/v1/disk/resources/upload?path=qa-api-test-2/hello.txt",
          "protocol": "https",
          "host": [
            "cloud-api",
            "yandex",
            "net"
          ],
          "path": [
            "v1",
            "disk",
            "resources",
            "upload"
          ],
          "query": [
            {
              "key": "path",
              "value": "qa-api-test-2/hello.txt"
            }
          ]
        }
      },
      "response": []
    },
    {
